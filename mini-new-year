<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090014">
<title>For Mini ❤️ | New Year 2027</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  background:#05020d;
  color:#fff;
  font-family:Arial,Helvetica,sans-serif;
  overflow-x:hidden;
}

canvas{
  position:fixed;
  inset:0;
  pointer-events:none;
}

#stars{
  z-index:0;
}

#fireworks{
  z-index:20;
}

section{
  position:relative;
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:70px 20px;
  overflow:hidden;
}

.bg-glow{
  position:absolute;
  width:400px;
  height:400px;
  border-radius:50%;
  filter:blur(100px);
  opacity:.25;
  background:#9b5cff;
}

.glass{
  background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.13);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
  box-shadow:0 25px 80px rgba(0,0,0,.35);
}

/* LOADING */

#loader{
  position:fixed;
  inset:0;
  z-index:100;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#05020d;
  transition:opacity 1s,visibility 1s;
}

.loader-content{
  text-align:center;
}

.loader-heart{
  font-size:70px;
  animation:pulse 1s infinite;
}

.loader-text{
  margin-top:20px;
  color:#ddd;
  font-size:17px;
}

@keyframes pulse{
  50%{
    transform:scale(1.2);
  }
}

/* HERO */

.hero-content{
  position:relative;
  z-index:2;
  width:min(850px,100%);
  text-align:center;
}

.badge{
  display:inline-block;
  padding:10px 18px;
  border-radius:50px;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.15);
  color:#ddd;
  font-size:14px;
  letter-spacing:1px;
}

.hero h1{
  margin-top:25px;
  font-size:clamp(48px,10vw,105px);
  line-height:.95;
  background:linear-gradient(90deg,#fff,#ffc9ee,#cbbaff,#fff);
  background-size:300%;
  -webkit-background-clip:text;
  color:transparent;
  animation:gradient 5s linear infinite;
}

@keyframes gradient{
  to{
    background-position:300%;
  }
}

.hero p{
  max-width:650px;
  margin:25px auto;
  color:#cfc9d9;
  font-size:19px;
  line-height:1.7;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  border:0;
  padding:15px 25px;
  border-radius:50px;
  cursor:pointer;
  font-size:16px;
  font-weight:bold;
  background:linear-gradient(135deg,#fff,#ffc6eb);
  color:#180b20;
  box-shadow:0 12px 35px rgba(255,180,230,.2);
  transition:.3s;
}

.btn:hover{
  transform:translateY(-4px) scale(1.03);
}

.scroll{
  margin-top:45px;
  color:#aaa;
  font-size:13px;
  animation:bounce 2s infinite;
}

@keyframes bounce{
  50%{transform:translateY(8px);}
}

/* COUNTDOWN */

.content{
  width:min(1000px,100%);
  position:relative;
  z-index:2;
  text-align:center;
}

.section-title{
  font-size:clamp(35px,7vw,65px);
  margin-bottom:15px;
}

.section-sub{
  color:#aaa;
  margin-bottom:40px;
  line-height:1.6;
}

.countdown{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
  max-width:700px;
  margin:auto;
}

.time-box{
  padding:25px 10px;
  border-radius:20px;
}

.time-box strong{
  display:block;
  font-size:clamp(35px,7vw,60px);
}

.time-box span{
  color:#aaa;
  font-size:12px;
  letter-spacing:2px;
}

/* MESSAGE */

.letter{
  max-width:750px;
  margin:auto;
  padding:35px;
  border-radius:28px;
  text-align:left;
  line-height:1.9;
  color:#e9e5ed;
  font-size:17px;
}

.letter p{
  margin-bottom:20px;
}

.highlight{
  color:#ffc8ec;
  font-weight:bold;
}

/* MEMORY CARDS */

.cards{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.card{
  padding:30px 22px;
  border-radius:25px;
  text-align:center;
  transition:.3s;
}

.card:hover{
  transform:translateY(-8px);
}

.card-icon{
  font-size:45px;
  margin-bottom:18px;
}

.card h3{
  margin-bottom:12px;
}

.card p{
  color:#aaa;
  line-height:1.6;
  font-size:14px;
}

/* TIMELINE */

.timeline{
  max-width:750px;
  margin:auto;
  text-align:left;
}

.timeline-item{
  position:relative;
  padding:0 0 40px 45px;
  border-left:2px solid rgba(255,255,255,.15);
}

.timeline-item:last-child{
  border-left:0;
}

.dot{
  position:absolute;
  left:-8px;
  top:0;
  width:14px;
  height:14px;
  border-radius:50%;
  background:#fff;
  box-shadow:0 0 20px #fff;
}

.timeline-item h3{
  margin-bottom:8px;
  color:#ffc9ed;
}

.timeline-item p{
  color:#aaa;
  line-height:1.7;
}

/* SURPRISE */

.surprise-box{
  max-width:700px;
  margin:auto;
  padding:45px 25px;
  border-radius:30px;
}

.lock{
  font-size:75px;
  margin-bottom:20px;
}

.hidden-message{
  display:none;
  margin-top:30px;
  animation:appear .8s ease;
}

@keyframes appear{
  from{
    opacity:0;
    transform:translateY(20px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

.big-text{
  font-size:clamp(35px,8vw,70px);
  margin:20px 0;
}

/* FINAL */

.final{
  text-align:center;
}

.final h2{
  font-size:clamp(45px,10vw,95px);
  background:linear-gradient(90deg,#fff,#ffc8ed,#c8b9ff);
  -webkit-background-clip:text;
  color:transparent;
}

.final p{
  max-width:650px;
  margin:25px auto;
  color:#bbb;
  line-height:1.8;
  font-size:18px;
}

.signature{
  color:#ffc8ed!important;
  font-weight:bold;
}

/* MUSIC */

.music{
  position:fixed;
  right:18px;
  bottom:18px;
  z-index:50;
  width:50px;
  height:50px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.2);
  background:rgba(255,255,255,.1);
  color:#fff;
  cursor:pointer;
  backdrop-filter:blur(10px);
}

/* RESPONSIVE */

@media(max-width:700px){

  section{
    padding:60px 18px;
  }

  .countdown{
    grid-template-columns:repeat(2,1fr);
  }

  .cards{
    grid-template-columns:1fr;
  }

  .letter{
    padding:25px 20px;
    font-size:15px;
  }

  .hero p{
    font-size:16px;
  }

  .section-sub{
    font-size:14px;
  }
}
</style>
</head>

<body>

<div id="loader">
  <div class="loader-content">
    <div class="loader-heart">❤️</div>
    <div class="loader-text">Preparing something special for Mini...</div>
  </div>
</div>

<canvas id="stars"></canvas>
<canvas id="fireworks"></canvas>

<!-- HERO -->

<section class="hero">

  <div class="bg-glow"></div>

  <div class="hero-content">

    <div class="badge">A LITTLE NEW YEAR SURPRISE ✨</div>

    <h1>Happy New Year,<br>Mini ❤️</h1>

    <p>
      Ek naya saal start hone wala hai...
      aur iss baar New Year thoda zyada special hai,
