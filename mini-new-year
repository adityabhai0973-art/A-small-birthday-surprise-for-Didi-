    </div>

  </div>

</section>


<!-- FINAL -->

<section class="final">

  <div class="content">

    <div style="font-size:70px;">
      🎆
    </div>

    <h2>Welcome Back,<br>Mini ❤️</h2>

    <p>
      Happy New Year 2027! 🎉
      <br><br>
      May this year bring you countless reasons
      to smile, laugh and make beautiful memories.
    </p>

    <p class="signature">
      And yes... you were missed. 🫂❤️
    </p>

    <button class="btn" onclick="launchFireworks(20)">
      🎆 Celebrate Again
    </button>

  </div>

</section>


<button class="music" onclick="toggleMusic()" id="musicBtn">
  🔇
</button>


<script>

/* LOADER */

window.addEventListener("load",()=>{

  setTimeout(()=>{

    document.getElementById("loader").style.opacity="0";
    document.getElementById("loader").style.visibility="hidden";

  },1500);

});


/* SMOOTH NAVIGATION */

function goTo(id){

  document.getElementById(id).scrollIntoView({
    behavior:"smooth"
  });

}


/* STARS */

const starsCanvas=document.getElementById("stars");
const starsCtx=starsCanvas.getContext("2d");

function resizeStars(){

  starsCanvas.width=innerWidth;
  starsCanvas.height=innerHeight;

}

resizeStars();

window.addEventListener("resize",resizeStars);

let stars=[];

for(let i=0;i<180;i++){

  stars.push({

    x:Math.random()*innerWidth,
    y:Math.random()*innerHeight,
    r:Math.random()*1.7,
    speed:Math.random()*.02+.005,
    phase:Math.random()*Math.PI*2

  });

}

function drawStars(){

  starsCtx.clearRect(
    0,
    0,
    starsCanvas.width,
    starsCanvas.height
  );

  stars.forEach(s=>{

    s.phase+=s.speed;

    let opacity=.25+
      (Math.sin(s.phase)+1)/4;

    starsCtx.globalAlpha=opacity;

    starsCtx.fillStyle="white";

    starsCtx.beginPath();

    starsCtx.arc(
      s.x,
      s.y,
      s.r,
      0,
      Math.PI*2
    );

    starsCtx.fill();

  });

  starsCtx.globalAlpha=1;

  requestAnimationFrame(drawStars);

}

drawStars();


/* COUNTDOWN */

const targetDate=new Date("January 1, 2027 00:00:00").getTime();

function updateCountdown(){

  const now=Date.now();

  let distance=targetDate-now;

  if(distance<0){
    distance=0;
  }

  const days=Math.floor(
    distance/(1000*60*60*24)
  );

  const hours=Math.floor(
    (distance%(1000*60*60*24))/
    (1000*60*60)
  );

  const minutes=Math.floor(
    (distance%(1000*60*60))/
    (1000*60)
  );

  const seconds=Math.floor(
    (distance%(1000*60))/1000
  );

  document.getElementById("days").textContent=
    String(days).padStart(2,"0");

  document.getElementById("hours").textContent=
    String(hours).padStart(2,"0");

  document.getElementById("minutes").textContent=
    String(minutes).padStart(2,"0");

  document.getElementById("seconds").textContent=
    String(seconds).padStart(2,"0");

}

updateCountdown();

setInterval(updateCountdown,1000);


/* SURPRISE */

function openSurprise(){

  document.getElementById("lock").textContent="💖";

  document.getElementById("surpriseBtn").textContent=
    "Surprise Opened ❤️";

  document.getElementById("surpriseBtn").disabled=true;

  document.getElementById("hiddenMessage").style.display="block";

  launchFireworks(12);

  createConfetti();

}


/* FIREWORKS */

const fwCanvas=document.getElementById("fireworks");
const fwCtx=fwCanvas.getContext("2d");

function resizeFireworks(){

  fwCanvas.width=innerWidth;
  fwCanvas.height=innerHeight;

}

resizeFireworks();

window.addEventListener(
  "resize",
  resizeFireworks
);

let particles=[];

function createFirework(x,y){

  for(let i=0;i<90;i++){

    const angle=
      Math.random()*Math.PI*2;

    const speed=
      Math.random()*5+2;

    particles.push({

      x:x,
      y:y,

      vx:Math.cos(angle)*speed,

      vy:Math.sin(angle)*speed,

      life:100,

      size:Math.random()*2+1

    });

  }

}

function fireworkAnimation(){

  fwCtx.clearRect(
    0,
    0,
    fwCanvas.width,
    fwCanvas.height
  );

  particles.forEach((p,index)=>{

    p.x+=p.vx;
    p.y+=p.vy;

    p.vy+=.045;

    p.life-=1;

    fwCtx.globalAlpha=p.life/100;

    fwCtx.fillStyle="white";

    fwCtx.beginPath();

    fwCtx.arc(
      p.x,
      p.y,
      p.size,
      0,
      Math.PI*2
    );

    fwCtx.fill();

    if(p.life<=0){
      particles.splice(index,1);
    }

  });

  fwCtx.globalAlpha=1;

  requestAnimationFrame(
    fireworkAnimation
  );

}

fireworkAnimation();


function launchFireworks(amount=5){

  let count=0;

  const interval=setInterval(()=>{

    createFirework(
      Math.random()*innerWidth,
      Math.random()*innerHeight*.55
    );

    count++;

    if(count>=amount){
      clearInterval(interval);
    }

  },250);

}


/* CONFETTI */

function createConfetti(){

  for(let i=0;i<150;i++){

    const piece=document.createElement("div");

    piece.style.position="fixed";

    piece.style.left=
      Math.random()*100+"vw";

    piece.style.top="-15px";

    piece.style.width="7px";

    piece.style.height="12px";

    piece.style.background="white";

    piece.style.borderRadius="2px";

    piece.style.zIndex="30";

    document.body.appendChild(piece);

    const duration=
      Math.random()*3+2;

    piece.animate(

      [
        {
          transform:"translateY(0) rotate(0)"
        },
        {
          transform:
            "translateY(110vh) rotate(720deg)"
        }
      ],

      {
        duration:duration*1000,
        easing:"ease-out"
      }

    );

    setTimeout(
      ()=>piece.remove(),
      duration*1000
    );

  }

}


/* MUSIC BUTTON
   No external music is loaded.
   This button simply gives visual feedback.
*/

let musicOn=false;

function toggleMusic(){

  musicOn=!musicOn;

  document.getElementById("musicBtn").textContent=
    musicOn ? "🔊" : "🔇";

}


/* RANDOM FIREWORKS */

setTimeout(()=>{
  launchFireworks(3);
},2200);

</script>

</body>
</html>
